{
  "$description": "KubeMetal 데스크톱 대시보드 디자인 토큰 (DTCG 스타일). 값 변경 시 tailwind.config.js의 theme.extend 매핑도 함께 갱신할 것.",
  "color": {
    "bg": {
      "base": { "$type": "color", "$value": "#0b0f16", "$description": "앱 최상위 배경 (body)" },
      "surface": { "$type": "color", "$value": "#131a26", "$description": "카드/패널 배경" },
      "surface-raised": { "$type": "color", "$value": "#1c2433", "$description": "카드 내부 서브 카드, 강조 블록 배경" }
    },
    "border": {
      "default": { "$type": "color", "$value": "#2b3444", "$description": "카드/구분선 기본 테두리 (장식용)" },
      "strong": { "$type": "color", "$value": "#5a6684", "$description": "인터랙티브 요소(버튼/인풋) 테두리, WCAG 1.4.11 비텍스트 대비 3:1 충족" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#f4f7fb", "$description": "페이지/섹션 타이틀, 핵심 수치. bg.surface 대비 16.2:1" },
      "secondary": { "$type": "color", "$value": "#c7cedb", "$description": "본문 텍스트. bg.surface 대비 11.0:1" },
      "muted": { "$type": "color", "$value": "#98a2b5", "$description": "캡션/보조 설명. bg.surface 대비 6.8:1 (AA 4.5:1 초과 충족)" },
      "inverse": { "$type": "color", "$value": "#ffffff", "$description": "accent.strong/danger.strong solid 버튼 배경 위 텍스트. accent.strong 대비 5.9:1, danger.strong 대비 5.4:1" }
    },
    "accent": {
      "default": { "$type": "color", "$value": "#5b93f5", "$description": "링크/아이콘/포커스 링/보조 강조" },
      "strong": { "$type": "color", "$value": "#2f5fc4", "$description": "solid 버튼 배경. 흰 텍스트 대비 5.9:1" }
    },
    "success": {
      "default": { "$type": "color", "$value": "#3ddc97", "$description": "성공/실행중 상태 텍스트·아이콘·뱃지" },
      "strong": { "$type": "color", "$value": "#1f9d6b", "$description": "success solid fill 배경용 예비 토큰" }
    },
    "warning": {
      "default": { "$type": "color", "$value": "#f5b642", "$description": "경고 상태 텍스트·아이콘·뱃지" },
      "strong": { "$type": "color", "$value": "#b9861f", "$description": "warning solid fill 배경용 예비 토큰" }
    },
    "danger": {
      "default": { "$type": "color", "$value": "#ff7a7a", "$description": "위험/중지 상태 텍스트·아이콘·뱃지" },
      "strong": { "$type": "color", "$value": "#bf3939", "$description": "solid 버튼 배경(정지 액션). 흰 텍스트 대비 5.4:1" }
    }
  },
  "spacing": {
    "0.5": { "$type": "dimension", "$value": "2px" },
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" }
  },
  "typography": {
    "fontFamily": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "-apple-system",
          "BlinkMacSystemFont",
          "Apple SD Gothic Neo",
          "Pretendard",
          "SF Pro Text",
          "SF Pro Display",
          "Segoe UI",
          "Roboto",
          "Helvetica",
          "Arial",
          "sans-serif"
        ]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": ["SF Mono", "JetBrains Mono", "ui-monospace", "Menlo", "monospace"]
      }
    },
    "fontSize": {
      "caption": { "$type": "dimension", "$value": "12px", "$extensions": { "lineHeight": "16px", "fontWeight": 500 } },
      "body": { "$type": "dimension", "$value": "14px", "$extensions": { "lineHeight": "20px", "fontWeight": 400 } },
      "body-strong": { "$type": "dimension", "$value": "14px", "$extensions": { "lineHeight": "20px", "fontWeight": 600 } },
      "subtitle": { "$type": "dimension", "$value": "16px", "$extensions": { "lineHeight": "24px", "fontWeight": 500 } },
      "section": { "$type": "dimension", "$value": "20px", "$extensions": { "lineHeight": "28px", "fontWeight": 700 } },
      "title": { "$type": "dimension", "$value": "24px", "$extensions": { "lineHeight": "32px", "fontWeight": 800 } },
      "metric": { "$type": "dimension", "$value": "32px", "$extensions": { "lineHeight": "40px", "fontWeight": 700, "fontVariantNumeric": "tabular-nums" } }
    }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "6px", "$description": "뱃지, 소형 버튼" },
    "md": { "$type": "dimension", "$value": "8px", "$description": "버튼, 인풋" },
    "lg": { "$type": "dimension", "$value": "12px", "$description": "카드, 서브 카드" },
    "xl": { "$type": "dimension", "$value": "16px", "$description": "패널, 배너" },
    "full": { "$type": "dimension", "$value": "9999px", "$description": "필/뱃지" }
  },
  "shadow": {
    "card": { "$type": "shadow", "$value": "0 1px 2px rgba(0,0,0,0.4), 0 8px 24px -4px rgba(0,0,0,0.35)", "$description": "기본 카드/패널" },
    "raised": { "$type": "shadow", "$value": "0 4px 16px -2px rgba(0,0,0,0.5)", "$description": "호버/강조 블록" }
  }
}
