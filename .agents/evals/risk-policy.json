{
  "schemaVersion": "openforge-agent-risk-policy/v1",
  "defaultRisk": "low",
  "traceRequiredAt": ["high"],
  "tracePathPrefix": ".agents/evals/traces/",
  "rules": [
    {"risk": "high", "pattern": ".github/workflows/**", "reason": "CI and release behavior"},
    {"risk": "high", "pattern": "scripts/airgap/**", "reason": "offline bundle and immutable artifact inputs"},
    {"risk": "high", "pattern": "scripts/k8s/**", "reason": "cluster mutation and deployment behavior"},
    {"risk": "high", "pattern": "scripts/mlx/**", "reason": "native ML runtime behavior"},
    {"risk": "high", "pattern": "src-tauri/**", "reason": "native desktop capability and privileged boundary"},
    {"risk": "high", "pattern": ".agents/**", "reason": "agent policy or evidence contract"}
  ]
}
