{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KubeMetal local opt-in evidence v1 (not a core API or Narwhal contract)",
  "type": "object",
  "required": [
    "schema_version",
    "observed_at",
    "run_id",
    "workload_id",
    "device",
    "limitations",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "kubemetal-local-accelerator-evidence/v1"
      ]
    },
    "observed_at": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "workload_id": {
      "type": "string",
      "minLength": 1
    },
    "device": {
      "type": "object",
      "required": [
        "name",
        "backend"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "backend": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "collector",
          "observed_at",
          "measurement_interval",
          "raw_json",
          "sha256",
          "observations",
          "limitations"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "gpu",
              "storage",
              "hardware",
              "metrics"
            ]
          },
          "collector": {
            "type": "object",
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "observed_at": {
            "type": "string",
            "minLength": 1
          },
          "measurement_interval": {
            "type": "object",
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "type": "string",
                "minLength": 1
              },
              "end": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "raw_json": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "[0-9a-f]{64}"
          },
          "observations": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "value",
                "unit",
                "status",
                "reason"
              ],
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": [
                    "number",
                    "string",
                    "null"
                  ]
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "measured",
                    "unavailable"
                  ]
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                }
              }
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
